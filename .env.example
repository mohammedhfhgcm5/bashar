# انسخ هذا الملف إلى .env قبل الرفع، وغيّر الأسرار.
POSTGRES_USER=damage
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=damage

WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
# اجعلها true عندما يكون الموقع خلف HTTPS
COOKIE_SECURE=false

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_PEPPER=replace-with-another-long-random-string

BOOTSTRAP_SUPERVISOR_EMAIL=supervisor@damage.local
BOOTSTRAP_SUPERVISOR_PASSWORD=change-me-now
BOOTSTRAP_SUPERVISOR_NAME=مشرف النظام
BOOTSTRAP_SUPERVISOR_PHONE=0900000000
